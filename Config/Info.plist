<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app appear in the share sheet for PDFs ("Open in Homework progress"). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF Document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- Incoming PDFs are copied into the app; the app then keeps its own copy. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- The class lessons backend, filled from Config/Base.xcconfig + Config/Local.xcconfig.
	     Empty values = the Class tab explains how to connect it. Publishable key only. -->
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string>$(SUPABASE_PUBLISHABLE_KEY)</string>
	<!-- Lora serif (SIL Open Font License 1.1, see Homework progress/Fonts/OFL.txt). -->
	<key>UIAppFonts</key>
	<array>
		<string>Lora-Regular.ttf</string>
		<string>Lora-Medium.ttf</string>
		<string>Lora-SemiBold.ttf</string>
		<string>Lora-Bold.ttf</string>
		<string>Lora-Italic.ttf</string>
	</array>
	<!-- Lets iCloud wake the app briefly to download changes made on the other device. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Only standard HTTPS/TLS is used, which is exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Local Supabase (supabase start) runs on plain HTTP; allow only local networking. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>he</string>
	</array>
</dict>
</plist>
