// Copy to Config/Local.xcconfig (git-ignored) and fill in YOUR values.
//
// xcconfig treats "//" as a comment, so URLs are written with $() between the slashes.

// Supabase Dashboard → Project Settings → API. Use the PUBLISHABLE (anon) key only.
SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_replace-me

// Archives (TestFlight / App Store) refuse an empty, local or placeholder backend; see
// scripts/check-release-config.sh. For a homework-only archive without the Class tab:
// ALLOW_ARCHIVE_WITHOUT_CLASS_BACKEND = YES

// Local development with `supabase start`:
// SUPABASE_URL = http:/$()/127.0.0.1:54321
// SUPABASE_PUBLISHABLE_KEY = <the "Publishable key" printed by `supabase status`>
