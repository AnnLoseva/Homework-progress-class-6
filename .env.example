# Copy to .env (git-ignored) for scripts and local Supabase. PLACEHOLDERS ONLY.
# The iOS app does NOT read this file; it uses Config/Local.xcconfig (see README).

# --- Local Supabase (`supabase start`) -------------------------------------------
# Apple Services ID / bundle id(s) allowed to sign in, comma separated.
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.yourname.woodland-study
# Only needed for web OAuth; leave empty for the native iOS flow.
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# --- Database tests against a LOCAL database (never production) ------------------
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Edge Function secrets: copy these four lines to supabase/functions/.env and run
#     `npx supabase secrets set --env-file supabase/functions/.env`. Never in the app. ---
# Used by delete-account to revoke Sign in with Apple tokens. Optional.
APPLE_TEAM_ID=YOURTEAMID
APPLE_KEY_ID=YOURKEYID
APPLE_CLIENT_ID=com.yourname.woodland-study
# Contents of the AuthKey_XXXX.p8 file; keep the real one out of git.
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
