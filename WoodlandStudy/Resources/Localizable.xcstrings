        }
      }
    },
    "Share": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיתוף"
          }
        }
      }
    },
    "Share %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיתוף %@"
          }
        }
      }
    },
    "Share export file": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיתוף קובץ הייצוא"
          }
        }
      }
    },
    "Sign in with Apple was turned off for this app, so you were signed out.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתחברות עם Apple בוטלה עבור האפליקציה, ולכן נותקת."
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקות"
          }
        }
      }
