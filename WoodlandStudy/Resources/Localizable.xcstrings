    },
    "Draft": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיוטה"
          }
        }
      }
    },
    "Drafts are invisible to students. Archived lessons stay in students' history but are no longer active work. Changing a lesson from required to optional automatically subscribes students who already started it.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טיוטות אינן גלויות לסטודנטים. שיעורים בארכיון נשארים בהיסטוריה של הסטודנטים אך אינם עבודה פעילה. שינוי שיעור מחובה לרשות רושם אוטומטית סטודנטים שכבר התחילו אותו."
          }
        }
      }
    },
