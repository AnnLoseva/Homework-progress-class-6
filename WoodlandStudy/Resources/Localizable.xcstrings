    "Downloaded files and cached data are removed from this device. Your progress stays in your account.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים שהורדו ונתונים שמורים יימחקו מהמכשיר. ההתקדמות שלך נשארת בחשבון."
          }
