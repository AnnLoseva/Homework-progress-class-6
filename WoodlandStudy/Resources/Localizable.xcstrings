          }
        }
      }
    },
    "Study next": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ללמוד עכשיו"
          }
        }
      }
    },
    "Subscribed": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשום"
          }
        }
      }
    },
    "Subtitle (e.g. the Hebrew name)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרת משנה (למשל השם בעברית)"
          }
        }
      }
    },
    "Suggest a code": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעת קוד"
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון"
          }
        }
      }
    },
    "Sync now": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון עכשיו"
          }
        }
      }
    },
    "Syncing %lld change(s)…": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסנכרן %lld שינויים…"
          }
        }
      }
    },
    "Syncing…": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסנכרן…"
          }
        }
      }
    },
    "That change isn't allowed for this lesson.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינוי הזה אינו מותר לשיעור הזה."
          }
        }
      }
    },
    "That code isn't right. Check it with your instructor.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד שגוי. כדאי לבדוק אותו עם המרצה."
          }
        }
      }
    },
    "That item no longer exists.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט כבר לא קיים."
          }
        }
      }
    },
    "The Supabase settings in Config/Local.xcconfig look invalid, so the app is running in demo mode.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגדרות Supabase בקובץ Config/Local.xcconfig נראות לא תקינות, ולכן האפליקציה פועלת במצב הדגמה."
          }
        }
      }
    },
    "The app was built with a Supabase SECRET key. It refuses to use it. Put the publishable key in Config/Local.xcconfig and rotate the secret key now.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה נבנתה עם מפתח SECRET של Supabase והיא מסרבת להשתמש בו. הכניסו את המפתח הציבורי (publishable) לקובץ Config/Local.xcconfig והחליפו מיד את המפתח הסודי."
          }
        }
      }
    },
    "The description is longer than %lld characters.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיאור ארוך מ־%lld תווים."
          }
        }
      }
    },
    "The downloaded file isn't a valid PDF.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ שהורד אינו PDF תקין."
          }
        }
      }
    },
    "The due date is before the availability date.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תאריך ההגשה מוקדם מתאריך הזמינות."
          }
        }
      }
    },
    "The export contains everything stored about you: subscriptions, progress, notes and your account id.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הייצוא כולל את כל מה שנשמר עליך: הרשמות, התקדמות, הערות ומזהה החשבון."
          }
        }
      }
    },
    "The file is empty.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ ריק."
          }
        }
      }
    },
    "The file is larger than 50 MB.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ גדול מ־50MB."
          }
        }
      }
    },
    "The file name isn't valid.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שם הקובץ אינו תקין."
          }
        }
      }
    },
    "The lesson and its PDFs are removed. Lessons that students have worked on can't be deleted; archive them instead.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיעור וקובצי ה־PDF שלו יוסרו. אי אפשר למחוק שיעורים שסטודנטים עבדו עליהם; במקום זאת העבירו אותם לארכיון."
          }
        }
      }
    },
    "The sign-in service is not available.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות ההתחברות אינו זמין."
          }
        }
      }
    },
    "The title is longer than %lld characters.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכותרת ארוכה מ־%lld תווים."
          }
        }
      }
    },
    "This file is for class members. Join the class in Settings with the code from your instructor.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ מיועד לחברי הכיתה. הצטרפו לכיתה בהגדרות עם הקוד שקיבלתם מהמרצה."
          }
        }
      }
    },
    "This file is missing on the server. Please let your instructor know so they can upload it again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקובץ חסר בשרת. עדכנו את המרצה כדי שיעלה אותו מחדש."
          }
        }
      }
    },
    "This lesson has no numbered exercises. Mark it completed when you're done.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשיעור הזה אין תרגילים ממוספרים. סמנו אותו כהושלם כשתסיימו."
          }
        }
      }
    },
    "This lesson is archived. Your progress is kept for your records.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיעור בארכיון. ההתקדמות שלך נשמרת לתיעוד."
          }
        }
      }
    },
    "This lesson is no longer available.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיעור כבר לא זמין."
          }
        }
      }
    },
    "This lesson isn't available yet.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיעור עדיין לא זמין."
          }
        }
      }
    },
    "This lesson was unpublished or removed. Any progress you recorded is kept.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פרסום השיעור בוטל או שהוא הוסר. כל ההתקדמות שתיעדת נשמרת."
          }
        }
      }
    },
    "This permanently deletes your account, subscriptions, progress and notes from the server and this device. It cannot be undone. You'll be asked to confirm with Apple.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה מוחקת לצמיתות את החשבון, ההרשמות, ההתקדמות וההערות מהשרת ומהמכשיר. אי אפשר לבטל אותה. תתבקשו לאשר באמצעות Apple."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כותרת"
          }
        }
      }
    },
    "Too many attempts. Try again in an hour.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות. נסו שוב בעוד שעה."
          }
        }
      }
    },
    "Try removing a filter.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסו להסיר מסנן."
          }
        }
      }
    },
    "Unavailable lesson": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיעור לא זמין"
          }
        }
      }
    },
    "Unpublish (back to draft)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול פרסום (חזרה לטיוטה)"
          }
        }
      }
    },
    "Unsubscribing keeps your progress; subscribe again any time.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול ההרשמה שומר את ההתקדמות; אפשר להירשם שוב בכל עת."
          }
        }
      }
    },
    "Unsubscribing never deletes your progress. Subscribe again and it's all still there.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול הרשמה לעולם לא מוחק את ההתקדמות. הירשמו שוב והכול עדיין שם."
          }
        }
      }
    },
    "Up to date": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעודכן"
          }
        }
      }
    },
    "Upload": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאה"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה"
          }
        }
      }
    },
    "Was due %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היה להגשה עד %@"
          }
        }
      }
    },
    "Week": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבוע"
          }
        }
      }
    },
    "Week %lld": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שבוע %lld"
          }
        }
      }
    },
    "Week must be between 0 and 60.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השבוע צריך להיות בין 0 ל־60."
          }
        }
      }
    },
    "Welcome to the class!": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוכים הבאים לכיתה!"
          }
        }
      }
    },
    "What this app stores": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מה האפליקציה שומרת"
          }
        }
      }
    },
    "When required lessons are published, or you subscribe to optional ones, they'll appear here.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשיתפרסמו שיעורי חובה, או כשתירשמו לשיעורי רשות, הם יופיעו כאן."
          }
        }
      }
    },
    "Who can open it": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מי יכול לפתוח"
          }
        }
      }
    },
    "Who can see it": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מי יכול לראות"
          }
        }
      }
    },
    "Woodland Study": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Woodland Study"
          }
        }
      }
    },
    "Woodland Study Tracker is open-source software (MIT License). Lora font: SIL Open Font License 1.1.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Woodland Study Tracker היא תוכנת קוד פתוח (רישיון MIT). הגופן Lora: SIL Open Font License 1.1."
          }
        }
      }
    },
    "Workload": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עומס עבודה"
          }
        }
      }
    },
    "You don't have access to this file.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין לך גישה לקובץ הזה."
          }
        }
      }
    },
    "You haven't subscribed to optional lessons. Browse the catalog to add some.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עוד לא נרשמת לשיעורי רשות. עיינו בקטלוג כדי להוסיף."
          }
        }
      }
    },
    "You signed out. Data from this device was removed.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התנתקת. הנתונים נמחקו מהמכשיר."
          }
        }
      }
    },
    "You unsubscribed · progress kept": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטלת הרשמה · ההתקדמות נשמרה"
          }
        }
      }
    },
    "You're already a member.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר הצטרפת."
          }
        }
      }
    },
    "You're offline and this file hasn't been downloaded yet.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור והקובץ עוד לא הורד."
          }
        }
      }
    },
    "You're offline. Changes will sync when you reconnect.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור. השינויים יסונכרנו כשהחיבור יחזור."
          }
        }
      }
    },
    "You're offline. Connect to the internet to sign in.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור. התחברו לאינטרנט כדי להיכנס."
          }
        }
      }
    },
    "You're offline. Content changes need a connection.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין חיבור. שינויי תוכן דורשים חיבור."
          }
        }
      }
    },
    "Your Apple ID is only used to sign you in. Your progress and notes are private to you.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה־Apple ID משמש רק להתחברות. ההתקדמות וההערות שלך פרטיות."
          }
        }
      }
    },
    "Your account and all your data were deleted.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון וכל הנתונים שלך נמחקו."
          }
        }
      }
    },
    "Your account doesn't have administrator rights for this.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחשבון שלך אין הרשאות ניהול לפעולה הזו."
          }
        }
      }
    },
    "Your account was not deleted: %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון לא נמחק: %@"
          }
        }
      }
    },
    "Your data": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנתונים שלך"
          }
        }
      }
    },
    "Your instructor hasn't published lessons yet.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרצה עוד לא פרסם שיעורים."
          }
        }
      }
    },
    "Your instructor hasn't set a class code yet.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרצה עוד לא הגדיר קוד כיתה."
          }
        }
      }
    },
    "Your instructor shares this code. It unlocks materials marked “Class members”.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרצה משתף את הקוד הזה. הוא פותח חומרים שמסומנים „חברי הכיתה”."
          }
        }
      }
    },
    "Your session expired. Please sign in again.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקף ההתחברות. יש להתחבר שוב."
          }
        }
      }
    },
    "Your session expired. Please sign in again; changes saved on this device will sync afterwards.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקף ההתחברות. יש להתחבר שוב; שינויים שנשמרו במכשיר יסונכרנו לאחר מכן."
          }
        }
      }
    },
    "Your subscriptions and progress are stored in your account and sync to every device you sign in on. The app also keeps a copy on this device so it works offline.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההרשמות וההתקדמות שלך נשמרות בחשבון ומסתנכרנות לכל מכשיר שבו תתחברו. האפליקציה שומרת גם עותק במכשיר כדי לעבוד בלי חיבור."
          }
        }
      }
    },
    "Your workload": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עומס העבודה שלך"
          }
        }
      }
    },
    "v%lld · %@ · %@": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה %1$lld · %2$@ · %3$@"
          }
        }
      }
    },
    "–": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "–"
          }
        }
      }
    },
    "• A stable account id from Sign in with Apple. No name, email or Apple ID password is requested or stored.\n• Which optional lessons you follow.\n• Your progress, exercise counts and private notes.\n• Whether you joined the class with its code.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "• מזהה חשבון קבוע מ־Sign in with Apple. לא מתבקשים ולא נשמרים שם, דוא״ל או סיסמת Apple ID.\n• שיעורי הרשות שאת/ה עוקב/ת אחריהם.\n• ההתקדמות, מספר התרגילים וההערות הפרטיות שלך.\n• האם הצטרפת לכיתה עם הקוד."
          }
        }
      }
    }
  },
  "version": "1.0"
}
