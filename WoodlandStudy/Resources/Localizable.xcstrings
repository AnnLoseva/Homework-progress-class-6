{
  "sourceLanguage": "en",
  "strings": {
    "%lld / %lld": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld PDF": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld PDF"
          }
        }
      }
    },
    "%lld attachment(s)": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld קבצים מצורפים"
          }
        }
      }
    },
    "%lld change(s) haven't synced yet and will be lost. Downloaded files and cached data are removed from this device.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld שינויים עדיין לא סונכרנו ויאבדו. קבצים שהורדו ונתונים שמורים יימחקו מהמכשיר."
          }
        }
      }
    },
    "%lld change(s) waiting": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld שינויים ממתינים"
          }
        }
      }
    },
    "%lld of %lld lessons completed": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld מתוך %2$lld שיעורים הושלמו"
          }
        }
      }
    },
    "%lld remaining": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נותרו %lld"
          }
        }
      }
    },
    "%lld/%lld exercises": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld תרגילים"
          }
        }
      }
    },
    "A cache of lessons, your progress and downloaded PDFs, so the app works offline. It is removed when you sign out or delete your account. Recently opened lessons are remembered on this device only.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עותק של השיעורים, ההתקדמות שלך וקובצי PDF שהורדו, כדי שהאפליקציה תעבוד גם בלי חיבור. העותק נמחק כשמתנתקים או מוחקים את החשבון. שיעורים שנפתחו לאחרונה נשמרים רק במכשיר הזה."
          }
        }
      }
    },
    "A lesson can't be its own prerequisite.": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיעור לא יכול להיות דרישת קדם של עצמו."
          }
        }
      }
    },
