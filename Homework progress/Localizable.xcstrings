    "Added %lld class lesson(s) to your weeks." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נוספו %lld שיעורי כיתה לשבועות שלך."
          }
        }
      }
    },
    "Adds every class lesson, required and optional, to your homework weeks with its PDFs, and keeps the progress in Homework and Class in step. Turning this off keeps what was added." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף כל שיעור של הכיתה, חובה ורשות, לשבועות שיעורי הבית שלך יחד עם קובצי ה-PDF, ושומר על אותה התקדמות בשיעורי הבית ובכיתה. כיבוי לא מוחק את מה שכבר נוסף."
          }
        }
      }
    },
    "Adds every class lesson, required and optional, to your homework weeks with its PDFs. Your progress there stays yours, and turning this off keeps what was added." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף כל שיעור של הכיתה, חובה ורשות, לשבועות שיעורי הבית שלך יחד עם קובצי ה-PDF. ההתקדמות שלך שם נשארת שלך, וכיבוי לא מוחק את מה שכבר נוסף."
          }
        }
      }
    },
    "Adds the lessons of the courses you pick, required and optional, to the matching homework week with their PDFs, as soon as they're published, and keeps the progress in Homework and Class in step. Your other devices follow automatically. Turning this off keeps what was added." : {
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוסיף את השיעורים של הקורסים שבחרת, חובה ורשות, לשבוע המתאים בשיעורי הבית יחד עם קובצי ה-PDF, ברגע שהם מתפרסמים, ושומר על אותה התקדמות בשיעורי הבית ובכיתה. המכשירים האחרים שלך מתעדכנים אוטומטית. כיבוי לא מוחק את מה שכבר נוסף."
          }
        }
      }
    },
