  "strings" : {
    " in the “%@” folder" : {
      "comment" : "A message that appears in a notification when a PDF is shared. The argument is the name of the notebook, if any.",
      "isCommentAutoGenerated" : true
    },
    "%@ Notebook" : {},
    "%@ doesn’t offer a supported way for other apps to open a specific notebook, so this step is manual." : {},
    "%@ doesn’t publish a way for other apps to open a specific notebook. The folder name is shown as a reminder when you open %@ yourself. If you have a link that opens this notebook (for example one you copied in %@), paste it here and the app will open it — but it can’t check which note the link opens." : {},
    "%@ · due %@" : {
      "comment" : "The body of a notification. The first argument is the course name. The second argument is the due date.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
