    },
    "A cache of lessons, your progress and downloaded PDFs, so the app works offline. It is removed when you sign out or delete your account. Recently opened lessons are remembered on this device only." : {
      "extractionState" : "stale",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עותק של השיעורים, ההתקדמות שלך וקובצי PDF שהורדו, כדי שהאפליקציה תעבוד גם בלי חיבור. העותק נמחק כשמתנתקים או מוחקים את החשבון. שיעורים שנפתחו לאחרונה נשמרים רק במכשיר הזה."
          }
        }
      }
    },
    "A lesson can't be its own prerequisite." : {
      "extractionState" : "stale",
      "localizations" : {
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שיעור לא יכול להיות דרישת קדם של עצמו."
          }
        }
      }
    },
